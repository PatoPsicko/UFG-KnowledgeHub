# UFG Knowledge Hub — configuración
# Copia este archivo como .env y ajusta los valores:
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# El archivo .env NO se sube al repositorio (ya está en .gitignore).

# ============================================================================
# 1. Inteligencia artificial (gratis, en la nube)
# ============================================================================
# El router prueba los proveedores en este orden y, si uno se queda sin cuota
# gratuita (error 429) o no responde, pasa solo al siguiente.
AI_PROVIDERS=gemini,groq,openrouter,ollama

# Google Gemini — clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_SECURITY_MODELS=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Groq — clave gratis en https://console.groq.com/keys (muy rápido)
GROQ_API_KEY=
GROQ_CHAT_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_SECURITY_MODELS=openai/gpt-oss-20b
# Detector de instrucciones ocultas (prompt injection) en los documentos.
GROQ_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# OpenRouter (opcional) — modelos ":free" en https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODELS=
OPENROUTER_SECURITY_MODELS=

# Ollama local (respaldo sin internet). Vacío = http://127.0.0.1:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300

# Modelo de vectores para la búsqueda: auto (Gemini si hay clave, si no Ollama), gemini, ollama o none.
AI_EMBED_PROVIDER=auto
# Segundos de espera por respuesta en la nube y tiempo de "enfriamiento" de un modelo sin cuota.
AI_TIMEOUT=60
AI_COOLDOWN_SECONDS=60

# Asistente: preguntas por usuario y minuto, respuestas simultáneas y espera en cola.
# Con Ollama local sin GPU conviene AI_MAX_CONCURRENT=1.
AI_RATE_LIMIT=12
AI_MAX_CONCURRENT=6
AI_QUEUE_TIMEOUT=90
# Búsqueda: tamaño de fragmento, candidatos y fragmentos que llegan al modelo.
AI_CHUNK_SIZE=1000
AI_CHUNK_OVERLAP=150
AI_CANDIDATES=24
AI_TOP_K=6
# Similitud mínima del mejor fragmento (vacío = automático según el modelo de vectores).
AI_MIN_SIMILARITY=

# ============================================================================
# 2. Vigilante de seguridad de archivos
# ============================================================================
# Orden de proveedores para el modelo que revisa lo que suben los estudiantes.
SECURITY_AI_PROVIDERS=groq,gemini,openrouter,ollama
# Antivirus del sistema: auto (Defender en Windows, ClamAV en Linux), defender, clamav u off.
SCAN_ANTIVIRUS=auto
SCAN_ANTIVIRUS_TIMEOUT=120
# 1 = si la IA no está disponible, el archivo espera a que un admin lo apruebe.
SCAN_REQUIRE_AI=0
# Umbral de Prompt Guard (0-1) para mandar un documento a revisión.
SCAN_PROMPT_GUARD_THRESHOLD=0.9

# ============================================================================
# 3. Cuentas y acceso
# ============================================================================
# Correos con acceso al panel de Seguridad, separados por comas.
ADMIN_EMAILS=
# Sólo permitir registrarse con estos dominios (p. ej. ufg.edu.sv). Vacío = cualquiera.
ALLOWED_EMAIL_DOMAINS=
# Registros permitidos por IP cada 10 minutos (un salón comparte la misma IP).
REGISTER_RATE_LIMIT=40
# Clave de las sesiones. Vacío = se genera una y se guarda en instance/.jwt_secret.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_HOURS=24

# ============================================================================
# 4. Servidor
# ============================================================================
# python wsgi.py escucha en 0.0.0.0:5001 con 32 hilos (suficiente para 20-50 personas).
APP_HOST=
APP_PORT=5001
APP_THREADS=32
MAX_UPLOAD_MB=25
# Base de datos y carpetas (vacío = instance/database.db, uploads/, instance/ai_index).
DATABASE_PATH=
UPLOAD_FOLDER=
AI_INDEX_DIR=
# Sólo si el frontend se sirve desde otro dominio.
CORS_ORIGINS=
# 1 activa el depurador de Werkzeug. Nunca en un servidor compartido.
FLASK_DEBUG=0
