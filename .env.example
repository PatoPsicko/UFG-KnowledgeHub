# Plantilla de configuración. Copia este archivo como .env y ajusta los valores.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# El archivo .env NO debe subirse al repositorio (ya está en .gitignore).

# Clave con la que se firman los tokens de sesión.
# Si se deja vacía, la aplicación genera una y la guarda en instance/.jwt_secret.
# Para producción, genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Orígenes autorizados para llamar a la API, separados por comas.
# Sólo hace falta si abres el frontend desde un servidor distinto (Live Server).
# Si usas "python app.py" y entras por http://127.0.0.1:5001 puedes dejarlo vacío.
CORS_ORIGINS=

# Ruta alternativa de la base de datos SQLite.
# Vacío = instance/database.db
DATABASE_PATH=

# Modo depuración. Déjalo en 0 salvo que estés depurando: con 1 se activa el
# depurador de Werkzeug, que permite ejecutar código desde el navegador.
FLASK_DEBUG=0

# Dirección y puerto de "python app.py". Vacío = 127.0.0.1:5001 (sólo esta PC).
# En un servidor: APP_HOST=0.0.0.0 (mejor aún, usar wsgi.py; ver docs/ASISTENTE_IA.md).
APP_HOST=
APP_PORT=

# --- Asistente de IA (Ollama) ---
# Dónde está Ollama. Vacío = http://127.0.0.1:11434 (Ollama en esta misma PC).
# En un servidor puede apuntar a otra máquina, p. ej. http://10.0.0.5:11434
OLLAMA_URL=
# Modelo que responde. Debe estar descargado: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
# Segundos de espera por respuesta (sin GPU la primera puede pasar del minuto).
OLLAMA_TIMEOUT=300
# Ventana de contexto en tokens. Más alto = más RAM.
OLLAMA_NUM_CTX=4096
# Tiempo que el modelo se queda cargado en memoria tras la última pregunta.
OLLAMA_KEEP_ALIVE=30m
# Fragmentos de documentos que se envían al modelo por pregunta.
AI_TOP_K=4
