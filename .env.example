# UFG Knowledge Hub — configuración
# Copia este archivo como .env y ajusta los valores:
#   Windows:  copy .env.example .env      (o doble clic en iniciar.bat, que lo hace solo)
#   Linux:    cp .env.example .env
# El archivo .env NO se sube al repositorio (ya está en .gitignore).

# ============================================================================
# 1. Inteligencia artificial (gratis, en la nube)
# ============================================================================
# El router prueba los proveedores en este orden y, si uno se queda sin cuota
# gratuita (error 429) o no responde, pasa solo al siguiente. Sin clave, un
# proveedor simplemente se salta.
AI_PROVIDERS=groq,gemini,openrouter

# Groq — clave gratis en https://console.groq.com/keys (muy rápido).
# Cuenta gratuita (oct. 2026): cada modelo admite 8.000 tokens por minuto y
# 1.000 peticiones al día, por separado. Con tres modelos el asistente tiene
# unas 24.000 tokens/min: entre 5 y 8 respuestas por minuto.
GROQ_API_KEY=
GROQ_CHAT_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# El vigilante usa el mismo gpt-oss-120b; gpt-oss-20b queda de respaldo.
GROQ_SECURITY_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Detector de instrucciones ocultas (prompt injection) en los documentos.
GROQ_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Google Gemini — clave gratis en https://aistudio.google.com/apikey
# Recomendado como segundo proveedor: añade cupo, vectores para la búsqueda y
# revisión de imágenes (Groq no tiene un modelo con visión).
GEMINI_API_KEY=
GEMINI_CHAT_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_SECURITY_MODELS=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# OpenRouter (opcional) — modelos ":free" en https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODELS=
OPENROUTER_SECURITY_MODELS=

# Ollama local (respaldo sin internet). Para usarlo añade "ollama" a AI_PROVIDERS.
# Ojo: sin tarjeta gráfica tarda 25-70 s por respuesta y carga mucho la PC.
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300

# Modelo de vectores para la búsqueda: auto (Gemini si hay clave, si no Ollama), gemini, ollama o none.
AI_EMBED_PROVIDER=auto
# Segundos de espera por respuesta en la nube y tiempo de "enfriamiento" de un modelo sin cuota.
AI_TIMEOUT=60
AI_COOLDOWN_SECONDS=60

# Asistente con muchas personas a la vez:
#   AI_RATE_LIMIT      preguntas por estudiante y minuto
#   AI_MAX_CONCURRENT  respuestas generándose a la vez (con Ollama sin GPU: 1)
#   AI_QUEUE_TIMEOUT   segundos que una pregunta espera cupo en cola; después se
#                      responde con los documentos encontrados, sin redactar
#   AI_MAX_TOKENS      tope de cada respuesta (Groq lo descuenta de la cuota)
#   AI_CACHE_MINUTES   la misma pregunta con los mismos extractos se responde de caché
#   AI_HISTORY_TURNS   turnos previos de la conversación que se reenvían al modelo
AI_RATE_LIMIT=12
AI_MAX_CONCURRENT=6
AI_QUEUE_TIMEOUT=150
AI_MAX_TOKENS=1200
AI_CACHE_MINUTES=15
AI_HISTORY_TURNS=4
# Búsqueda: tamaño de fragmento, candidatos y fragmentos que llegan al modelo.
AI_CHUNK_SIZE=1000
AI_CHUNK_OVERLAP=150
AI_CANDIDATES=24
AI_TOP_K=5
# Similitud mínima del mejor fragmento (vacío = automático según el modelo de vectores).
AI_MIN_SIMILARITY=
# Pruebas de carga: 1 = IA simulada (misma lógica de cuotas, sin red ni gasto).
AI_SIMULATED=0

# ============================================================================
# 2. Vigilante de seguridad de archivos
# ============================================================================
# Orden de proveedores para el modelo que revisa lo que suben los estudiantes.
SECURITY_AI_PROVIDERS=groq,gemini,openrouter
# Tokens por minuto que el vigilante deja libres para las preguntas de los estudiantes.
AI_SECURITY_RESERVE_TOKENS=3000
# Caracteres de cada documento que se envían a la IA (~1.700 tokens) y espera máxima por cupo.
SCAN_AI_MAX_CHARS=6000
SCAN_AI_WAIT=90
# Si la IA no responde, minutos de espera antes de cada reintento.
SCAN_AI_RETRY_MINUTES=1,5,15,30,60
# Tras todos los reintentos sin IA: 1 = cuarentena (lo decide un admin), 0 = se publica con la nota.
SCAN_REQUIRE_AI=1
# Antivirus del sistema: auto (Defender en Windows, ClamAV en Linux), defender, clamav u off.
SCAN_ANTIVIRUS=auto
SCAN_ANTIVIRUS_TIMEOUT=120
# Umbral de Prompt Guard (0-1) para mandar un documento a cuarentena.
SCAN_PROMPT_GUARD_THRESHOLD=0.9

# ============================================================================
# 3. Cuentas y acceso
# ============================================================================
# Correos con acceso al panel de Seguridad, separados por comas.
ADMIN_EMAILS=
# Dominios con los que se puede crear una cuenta. Exacto: ufg.edu.sv;
# con subdominios: *.ufg.edu.sv; cualquiera: * (no recomendado).
ALLOWED_EMAIL_DOMAINS=ufg.edu.sv
# Contraseña: mínimo de caracteres (siempre con letras y números).
PASSWORD_MIN_LENGTH=8
# Bloqueo temporal tras intentos fallidos seguidos con el mismo correo.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Registros permitidos por IP cada 10 minutos (un salón comparte la misma IP).
REGISTER_RATE_LIMIT=40
# Verificación por correo. Déjala en 0 hasta tener un servidor SMTP de verdad
# (por ejemplo, el de la universidad); con 1 nadie entra sin abrir el enlace.
EMAIL_VERIFICATION=0
SMTP_HOST=
SMTP_PORT=587
# starttls (puerto 587), ssl (puerto 465) o none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Dirección con la que entran los estudiantes, para los enlaces del correo.
APP_PUBLIC_URL=
# Clave de las sesiones. Vacío = se genera una y se guarda en instance/.jwt_secret.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_HOURS=24

# ============================================================================
# 4. Archivos
# ============================================================================
# Tamaño máximo por archivo y por foto de perfil.
MAX_UPLOAD_MB=25
AVATAR_MAX_MB=4
# Espacio máximo por estudiante y archivos que puede subir en 24 horas.
USER_QUOTA_MB=300
UPLOADS_PER_DAY=40
# No se aceptan archivos si el disco tiene menos de esto libre.
MIN_FREE_DISK_MB=1024

# ============================================================================
# 5. Servidor
# ============================================================================
# python wsgi.py escucha en 0.0.0.0:5001 con 32 hilos (suficiente para 20-50 personas).
APP_HOST=
APP_PORT=5001
APP_THREADS=32
# Base de datos y carpetas (vacío = instance/database.db, uploads/, instance/ai_index).
DATABASE_PATH=
UPLOAD_FOLDER=
AI_INDEX_DIR=
# Sólo si el frontend se sirve desde otro dominio.
CORS_ORIGINS=
# 1 activa el depurador de Werkzeug. Nunca en un servidor compartido.
FLASK_DEBUG=0
