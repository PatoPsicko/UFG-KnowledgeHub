# Plantilla de configuración. Copia este archivo como .env y ajusta los valores.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# El archivo .env NO debe subirse al repositorio (ya está en .gitignore).

# Clave con la que se firman los tokens de sesión.
# Si se deja vacía, la aplicación genera una y la guarda en instance/.jwt_secret.
# Para producción, genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Orígenes autorizados para llamar a la API, separados por comas.
# Sólo hace falta si abres el frontend desde un servidor distinto (Live Server).
# Si usas "python app.py" y entras por http://127.0.0.1:5001 puedes dejarlo vacío.
CORS_ORIGINS=

# Ruta alternativa de la base de datos SQLite.
# Vacío = instance/database.db
DATABASE_PATH=

# Modo depuración. Déjalo en 0 salvo que estés depurando: con 1 se activa el
# depurador de Werkzeug, que permite ejecutar código desde el navegador.
FLASK_DEBUG=0
